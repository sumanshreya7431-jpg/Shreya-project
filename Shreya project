<!-- ================= SDGs ================= -->

<section id="sdgs" class="sdgs">

    <h2>🎯 The 17 Sustainable Development Goals</h2>

    <p class="section-subtitle">
        Global goals for a better and more sustainable world.<br>
        <span class="tap-hint">👆 Tap a goal to read more about it</span>
    </p>

    <!-- The 17 goal cards are built by script.js -->
    <div class="sdg-grid" id="sdgGrid"></div>

</section>


<!-- ================= HELP ================= -->

<section class="help">

    <h2>♻️ How Can WE Help?</h2>

    <div class="help-grid">

        <div class="help-card">
            <div>💧</div>
            <h3>Save Water</h3>
            <p>Close taps and avoid wasting water.</p>
        </div>

        <div class="help-card">
            <div>⚡</div>
            <h3>Save Energy</h3>
            <p>Switch off lights and appliances.</p>
        </div>

        <div class="help-card">
            <div>🌳</div>
            <h3>Plant Trees</h3>
            <p>Protect forests and green spaces.</p>
        </div>

        <div class="help-card">
            <div>♻️</div>
            <h3>Recycle</h3>
            <p>Reduce, reuse and recycle waste.</p>
        </div>

    </div>

</section>


<!-- ================= GREEN CITY ================= -->

<section id="city" class="city-section">

    <h2>🏙️ The Sustainable City of the Future</h2>

    <p class="section-subtitle">
        Imagine a city where technology and nature work together.
    </p>


    <div class="city">

        <div class="city-card">
            ☀️
            <h3>Solar Energy</h3>
            <p>Clean energy from the Sun.</p>
        </div>

        <div class="city-card">
            🌳
            <h3>Green Parks</h3>
            <p>More trees and fresh air.</p>
        </div>

        <div class="city-card">
            🚌
            <h3>Electric Transport</h3>
            <p>Cleaner public transportation.</p>
        </div>

        <div class="city-card">
            🚲
            <h3>Cycle Lanes</h3>
            <p>Healthy and pollution-free travel.</p>
        </div>

        <div class="city-card">
            💧
            <h3>Rainwater Harvesting</h3>
            <p>Collecting and reusing rainwater.</p>
        </div>

        <div class="city-card">
            ♻️
            <h3>Recycling Centres</h3>
            <p>Turning waste into useful materials.</p>
        </div>

    </div>

</section>


<!-- ================= QUIZ ================= -->

<section id="quiz" class="quiz">

    <h2>🎮 Sustainability Challenge</h2>

    <div class="quiz-box">

        <h3 id="question">
            Which source of energy is renewable?
        </h3>

        <button onclick="answer(0)">🛢️ Petroleum</button>

        <button onclick="answer(1)">⛏️ Coal</button>

        <button onclick="answer(2)">☀️ Solar Energy</button>

        <button onclick="answer(3)">🔥 Natural Gas</button>

        <p id="result"></p>

        <button class="next" onclick="nextQuestion()">
            Next Question ➡️
        </button>

    </div>

</section>


<!-- ================= ECO SCORE ================= -->

<section class="eco-section">

    <h2>🌱 Find Your Eco Score</h2>

    <div class="eco-box">

        <label>
            <input type="checkbox" class="eco">
            💡 I switch off unnecessary lights.
        </label>

        <label>
            <input type="checkbox" class="eco">
            💧 I save water.
        </label>

        <label>
            <input type="checkbox" class="eco">
            ♻️ I reuse and recycle things.
        </label>

        <label>
            <input type="checkbox" class="eco">
            🍎 I avoid wasting food.
        </label>

        <label>
            <input type="checkbox" class="eco">
            🌳 I protect or plant trees.
        </label>

        <button class="main-button" onclick="calculateScore()">
            Calculate Score 🌍
        </button>

        <h3 id="ecoResult"></h3>

    </div>

</section>


